## Interface: 30300
## Title: Ascension Vanity Tracker
## Notes: Shows vanity item drops in creature tooltips with region info
## Author: CTout
## Version: 2.3-dev
## SavedVariables: AscensionVanityDB, AscensionVanityDump
## SavedVariablesPerCharacter: AV_CreatureStats, AV_SessionStats, AV_CreatureStatsCache

# Shared constants (loads first - used by all other files)
AscensionVanityConstants.lua

# Configuration (loads second, sets defaults)
AscensionVanityConfig.lua

# Database files (V2 format - consolidated icon index in VanityDB.lua)
VanityDB.lua

# Database loader (provides lookup functions)
VanityDB_Loader.lua

# API Scanner (in-game data export tool)
APIScanner.lua

# User Interface (settings and scanner panels)
SettingsUI_Tabbed.lua
ScannerUI.lua

# Collection Progress Frame (v2.2+ standalone progress display)
CollectionProgressFrame.lua

# Regional Hunting Guide (v2.1+ zone-based item finder)
RegionalGuide.lua

# Database Browser (v2.2+ comprehensive database explorer and regional guide)
DatabaseBrowser.lua

# Statistics Tracker (v2.3+ kill/drop tracking for farming efficiency)
StatisticsTracker.lua

# Creature Information (v2.3+ enhanced creature data display)
CreatureInfo.lua

# Collection UI Enhancer (v2.3+ adds stats to collection preview)
CollectionUIEnhancer.lua

# Debug Tools (development only - uncomment when needed)
# DEBUG_Measurements.lua

# Core functionality
Core.lua

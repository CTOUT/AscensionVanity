VanityDB_Loader.lua

# API Scanner (in-game data export tool)
APIScanner.lua

# User Interface (settings and scanner panels)
SettingsUI.lua
ScannerUI.lua

# Collection Progress Frame (v2.2+ standalone progress display)
CollectionProgressFrame.lua

# Regional Hunting Guide (v2.1+ zone-based item finder)
RegionalGuide.lua

# Database Browser (v2.2+ comprehensive database explorer and regional guide)
DatabaseBrowser.lua


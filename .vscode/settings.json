{
    // ============================================================================
    // WoW API Extension Settings (MUST BE FIRST!)
    // ============================================================================
    // CRITICAL FIX: Prevent ketho.wow-api from resetting Lua workspace settings
    // Wiki: https://github.com/Ketho/vscode-wow-api/wiki/Settings#dev-mode
    // Issues: #181, #194
    "wowAPI.devMode": true,
    "wowAPI.luals.defineKnownGlobals": true,
    "wowAPI.luals.frameXML": true,
    
    // ============================================================================
    // Lua Language Server Settings
    // ============================================================================
    "Lua.runtime.version": "Lua 5.1",
    "Lua.runtime.builtin": {
        "basic": "default",    // WoW uses: print, type, pairs, ipairs, etc.
        "string": "default",   // WoW uses: string.format, string.find, etc.
        "table": "default",    // WoW uses: table.insert, table.sort, etc.
        "math": "default",     // WoW uses: math.floor, math.max, etc.
        "debug": "disable",    // Not available in WoW
        "io": "disable",       // Not available in WoW
        "os": "disable",       // Not available in WoW
        "package": "disable",  // Not available in WoW
        "utf8": "disable"      // Not available in WoW (Lua 5.3+)
    },
    "Lua.workspace.checkThirdParty": false,
    "Lua.workspace.library": [
        "${userHome}/.vscode/extensions/ketho.wow-api-0.21.0/Annotations/Core",
        "${userHome}/.vscode/extensions/ketho.wow-api-0.21.0/Annotations/FrameXML"
    ],
    "Lua.workspace.userThirdParty": [],
    "Lua.diagnostics.disable": [
        "lowercase-global" // WoW uses lowercase globals like "print"
    ],
    "Lua.diagnostics.globals": [
        "UISpecialFrames",
        "StaticPopupDialogs",
        "StaticPopup_Show",
        "SlashCmdList",
        "CollectionsJournal",
        "InterfaceOptions_AddCategory",
        "GameTooltip",
